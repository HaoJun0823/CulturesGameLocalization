    <string id="99">
      <text lang="CHN">圣火</text>
      <text lang="eng">THE HOLY FIRE</text>
      <text lang="ger">DAS HEILIGE FEUER</text>
      <text lang="l11">聖火</text>
      <text lang="l12" />
      <text lang="l13" />
