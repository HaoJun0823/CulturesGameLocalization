  <strings>
    <string id="0">
      <text lang="CHN">@解放众龙！</text>
      <text lang="ger">@BEFREIE ALLE DRACHEN!</text>
    </string>
    <string id="1">
      <text lang="CHN">寻得土龙。</text>
      <text lang="ger">Finde die Erddrachen.</text>
    </string>
    <string id="2">
      <text lang="CHN">寻得魔法龙。</text>
      <text lang="ger">Finde die Zauberdrachen.</text>
    </string>
    <string id="3">
      <text lang="CHN">寻得水龙。</text>
      <text lang="ger">Finde die Wasserdrachen.</text>
    </string>
    <string id="51">
      <text lang="CHN">特拉斯 - 土龙</text>
      <text lang="ger">Terras - Erddrachen</text>
    </string>
    <string id="52">
      <text lang="CHN">阿夸斯 - 魔法龙</text>
      <text lang="ger">Aquas - Zauberdrachen</text>
    </string>
    <string id="53">
      <text lang="CHN">阿布拉斯 - 水龙</text>
      <text lang="ger">Abras - Wasserdrachen</text>
    </string>
